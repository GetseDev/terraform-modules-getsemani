# Terraform state — never commit state or state backups
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform crash logs
crash.log
crash.*.log

# Terraform CLI config and cached providers/modules
.terraform/
.terraform.tfstate.lock.info
*.tfplan
*.tfplan.*
plan.out

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# Overrides that are usually local-only
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# AWS credentials
.aws/
credentials

# Local environment and editor files
.env
.env.*
.DS_Store
.idea/
.vscode/
*.swp
